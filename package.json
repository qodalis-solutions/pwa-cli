{
  "name": "pwa-cli",
  "version": "1.0.5",
  "description": "Qodalis CLI for phones: an offline web terminal, installable as a PWA and packaged for Google Play",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "serve:dist": "http-server ./dist/pwa-cli/browser -p 8080 -c-1 --gzip",
    "test": "playwright test",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p e2e/tsconfig.json",
    "screenshots": "STORE_SCREENSHOTS=1 playwright test --project=store",
    "assets": "node scripts/generate-assets.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run cap:sync && scripts/gradlew.sh assembleDebug",
    "android:bundle": "npm run cap:sync && scripts/gradlew.sh bundleRelease",
    "play:status": "fastlane status",
    "play:internal": "fastlane internal",
    "play:promote": "fastlane promote",
    "play:listing": "fastlane listing"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/toast": "^8.0.1",
    "@qodalis/angular-cli": "^2.0.0",
    "@qodalis/cli": "^2.0.0",
    "@qodalis/cli-2048": "^2.0.0",
    "@qodalis/cli-browser-storage": "^2.0.0",
    "@qodalis/cli-chart": "^2.0.0",
    "@qodalis/cli-core": "^2.0.0",
    "@qodalis/cli-cron": "^2.0.0",
    "@qodalis/cli-csv": "^2.0.0",
    "@qodalis/cli-curl": "^2.0.0",
    "@qodalis/cli-encode": "^2.0.0",
    "@qodalis/cli-files": "^2.0.0",
    "@qodalis/cli-guid": "^2.0.0",
    "@qodalis/cli-lang-de": "^2.0.0",
    "@qodalis/cli-lang-es": "^2.0.0",
    "@qodalis/cli-lang-fr": "^2.0.0",
    "@qodalis/cli-lang-it": "^2.0.0",
    "@qodalis/cli-lang-ja": "^2.0.0",
    "@qodalis/cli-lang-ko": "^2.0.0",
    "@qodalis/cli-lang-pt": "^2.0.0",
    "@qodalis/cli-lang-ro": "^2.0.0",
    "@qodalis/cli-lang-ru": "^2.0.0",
    "@qodalis/cli-lang-zh": "^2.0.0",
    "@qodalis/cli-markdown": "^2.0.0",
    "@qodalis/cli-minesweeper": "^2.0.0",
    "@qodalis/cli-password-generator": "^2.0.0",
    "@qodalis/cli-qr": "^2.0.0",
    "@qodalis/cli-regex": "^2.0.0",
    "@qodalis/cli-snake": "^2.0.0",
    "@qodalis/cli-speed-test": "^2.0.0",
    "@qodalis/cli-stopwatch": "^2.0.0",
    "@qodalis/cli-string": "^2.0.0",
    "@qodalis/cli-sudoku": "^2.0.0",
    "@qodalis/cli-tetris": "^2.0.0",
    "@qodalis/cli-text-to-image": "^2.0.0",
    "@qodalis/cli-todo": "^2.0.0",
    "@qodalis/cli-users": "^2.0.0",
    "@qodalis/cli-wget": "^2.0.0",
    "@qodalis/cli-wordle": "^2.0.0",
    "@qodalis/cli-yesno": "^2.0.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "http-server": "^14.1.1",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@angular/build": {
      "vite": "^8.3.5"
    },
    "@vitejs/plugin-basic-ssl": {
      "vite": "^8.3.5"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
